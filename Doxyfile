# Doxygen configuration. Only settings that differ from the defaults are
# listed; `doxygen -g` would print all ~300 of them. Run from the project root.

PROJECT_NAME           = Pacman
PROJECT_BRIEF          = "Game logic library and executable"
# Output goes inside the MkDocs docs_dir so the site picks it up as api/.
# docs/api is generated and listed in .gitignore.
OUTPUT_DIRECTORY       = docs
INPUT                  = src/Pacman
FILE_PATTERNS          = *.h
RECURSIVE              = NO
EXCLUDE                = src/Pacman/Tests

# Only what is documented on purpose: an undocumented public entity is an error.
EXTRACT_ALL            = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES

# HTML only, in one directory, without graphs (no Graphviz dependency).
GENERATE_HTML          = YES
HTML_OUTPUT            = api
GENERATE_LATEX         = NO
HAVE_DOT               = NO
JAVADOC_AUTOBRIEF      = YES
