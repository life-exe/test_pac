Checks: '-*,bugprone-*,performance-*,modernize-*,-modernize-use-trailing-return-type,-modernize-use-nodiscard,-modernize-use-designated-initializers,readability-*,-readability-magic-numbers,-readability-identifier-length,-readability-uppercase-literal-suffix,misc-const-correctness,-clang-diagnostic-ignored-gch'
WarningsAsErrors: '*'
HeaderFilterRegex: 'src[/\\](App|Common|Game)[/\\].*'
FormatStyle: file
CheckOptions:
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true
