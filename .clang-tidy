Checks: '-*,bugprone-*,performance-*,modernize-*,-modernize-use-trailing-return-type,-modernize-use-nodiscard,readability-*,-readability-magic-numbers,-readability-identifier-length,-readability-uppercase-literal-suffix,misc-const-correctness'
WarningsAsErrors: '*'
HeaderFilterRegex: 'src[/\\](App|Game)[/\\].*'
FormatStyle: file
